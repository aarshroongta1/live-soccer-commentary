# Anthropic
ANTHROPIC_API_KEY=

# OpenAI Responses API (choose one provider explicitly with `run --backend`)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Voice (day 10). Voice ids are a taste call: defaults are the stock George
# (caller) and Alice (analyst), picked to be told apart instantly.
ELEVENLABS_API_KEY=
ELEVENLABS_CALLER_VOICE=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_ANALYST_VOICE=Xb7hH8MSUJpSbSDYk0k2

# The excitement curve. Every beat carries an excitement from 0 to 1, and
# these are the voice settings at each end of it; a line in between is
# interpolated. Stability falls as excitement rises (less stability is more
# freedom to break pitch, which is what a goal sounds like), style and speed
# rise. The analyst's range is narrower at both ends on purpose: the second
# seat exists in order not to sound like the first one.
#
# None of these were chosen by ear. `uv run python scripts/voice_sweep.py
# --voice-id <id> --yes` renders a grid of them over five real lines and
# writes an index.html to listen to; replace them with what wins.
VOICE_CURVE=on
VOICE_CALLER_STABILITY_LOW=0.55
VOICE_CALLER_STABILITY_HIGH=0.20
VOICE_CALLER_STYLE_LOW=0.15
VOICE_CALLER_STYLE_HIGH=0.60
VOICE_CALLER_SPEED_LOW=1.00
VOICE_CALLER_SPEED_HIGH=1.15
VOICE_ANALYST_STABILITY_LOW=0.60
VOICE_ANALYST_STABILITY_HIGH=0.40
VOICE_ANALYST_STYLE_LOW=0.10
VOICE_ANALYST_STYLE_HIGH=0.35
VOICE_ANALYST_SPEED_LOW=0.97
VOICE_ANALYST_SPEED_HIGH=1.05
VOICE_SIMILARITY_BOOST=0.8
VOICE_SPEAKER_BOOST=on
# macOS `say` has one dial, words per minute, so the curve collapses to it.
VOICE_SAY_RATE_LOW=170
VOICE_SAY_RATE_HIGH=210
# Punctuation shaping, off by default: at high excitement a line is made to
# end on an exclamation mark and a bare leading name becomes its own call
# ("Mbappé, buried." -> "Mbappé! Buried!"), at low excitement a trailing
# exclamation mark becomes a full stop. Words are never changed and the
# analyst is never touched. Off because it edits a line the gate has already
# approved, which should be a deliberate choice.
VOICE_SHAPING=off

# Models. The caller runs roughly once every four seconds for ninety minutes,
# so it is most of the bill: try Haiku here first and see whether the quality
# holds before paying for Sonnet.
CALLER_MODEL=claude-sonnet-5
BOARD_MODEL=claude-haiku-4-5
ANALYST_MODEL=claude-opus-5
RESEARCHER_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5
# The phrasing stage: the caller's form said the way a commentator says it.
# One small call per spoken line, with two hundred real utterances in a cached
# system prefix. Set it to `off` and the caller's own words go straight to the
# gate, which is the runtime as it was before the stage existed.
PHRASER_MODEL=claude-haiku-4-5

# How far the narration cursor trails the live edge, and the hard spend ceiling
# for one match. Past the cap the system stops calling the model rather than
# quietly running up a bill on a stream somebody left open.
DELAY_S=8.0
MAX_USD_PER_MATCH=35.0

# Tracing (optional, self-hosted or cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Capture: name from `bash scripts/list_devices.sh`, e.g. "Capture screen 0".
# Prefer the name over an index like "1:0" — indices shift when hardware
# (e.g. an iPhone) is plugged in, the name doesn't.
AVFOUNDATION_DEVICE=Capture screen 0
